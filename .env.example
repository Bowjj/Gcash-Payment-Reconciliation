# Environment variables for Payment Reconciliation System
# Copy this file to .env.local and fill in the values.

# Supabase public client configuration (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# E2E test credentials (local development only, never commit real values)
E2E_USER_A_EMAIL=test-user-a@example.com
E2E_USER_A_PASSWORD=test-password-a
E2E_USER_A_BUSINESS=Test Business A
E2E_USER_B_EMAIL=test-user-b@example.com
E2E_USER_B_PASSWORD=test-password-b
E2E_USER_B_BUSINESS=Test Business B
